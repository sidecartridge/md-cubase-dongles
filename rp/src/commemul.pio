; RP2040 PIO program: ROM3 engine — capture the access address into a DMA ring
; (the command channel) AND drive a fixed word onto the data bus (the Cubase
; dongle response). Both jobs live in one 16-instruction program so it fits on
; pio0 alongside romemul (16) — a GPIO's output can only be driven by the PIO
; block that owns it, and romemul owns the shared bus pins on pio0, so the ROM3
; driver must live here too.
; Author: Diego Parrilla Santamaría
; Date: March 2026
;

; !ROM3 signal
.define public ROM3_GPIO 26

; Inverted signal semantics
.define public ACTIVE 0
.define public INACTIVE 1

; Inverted READ and WRITE pair of signals
; READ is the LSB, WRITE is the MSB
.define public READ_WRITE 0b00
.define public NOT_READ_WRITE 0b01
.define public READ_NOT_WRITE 0b10
.define public NOT_READ_NOT_WRITE 0b11

; Address/data bus width
.define public BUS_PINS 16

; Safe number of wait cycles before reading the address from the bus after
; asserting READ
.define public READ_ADDRESS_SAFE_WAIT_CYCLES 3

.program commemul_read
    .side_set 2 opt

; Preamble (runs once): pull the fixed ROM3 response word from the TX FIFO into
; the Y scratch register, then park the shared bus as input / high-Z.
    pull block                     side NOT_READ_NOT_WRITE
    mov y, osr
    mov osr, null
    out pindirs, BUS_PINS

.wrap_target
; Wait for ROM3 active, then strobe READ to enable the external address buffer,
; matching the ROM4 state machine timing.
    wait ACTIVE gpio ROM3_GPIO
    nop                            side READ_NOT_WRITE [READ_ADDRESS_SAFE_WAIT_CYCLES]
    nop                                             [READ_ADDRESS_SAFE_WAIT_CYCLES]
    nop                                             [READ_ADDRESS_SAFE_WAIT_CYCLES]

; Capture the 16-bit access into the RX FIFO (command channel). The m68k command
; protocol encodes commands in the ROM3 *address*, so this keeps working even
; though we also drive the data below.
    in pins BUS_PINS

; Flip the shared bus to output and drive the fixed response word, enabling the
; data transceiver toward the ST (READ inactive, WRITE active).
    mov osr, ~null
    out pindirs, BUS_PINS
    mov osr, y
    out pins BUS_PINS              side NOT_READ_WRITE

; Hold for the rest of the cycle, then release the bus back to input/high-Z.
    wait INACTIVE gpio ROM3_GPIO
    mov osr, null                  side NOT_READ_NOT_WRITE
    out pindirs, BUS_PINS
.wrap

% c-sdk {

static inline void commemul_read_program_init(PIO pio, uint sm, uint offset,
                                              uint addr_pin_base,
                                              uint addr_pin_count,
                                              uint rw_pin_base, float div) {
    pio_sm_config c = commemul_read_program_get_default_config(offset);

    sm_config_set_in_pins(&c, addr_pin_base);
    // Right-shift so the 16-bit sample lands in the upper halfword (DMA ring).
    sm_config_set_in_shift(&c, true, true, addr_pin_count);
    // Drive the response word from OSR[15:0]; no autopull (reloaded from Y each
    // cycle with `mov osr, y`).
    sm_config_set_out_pins(&c, addr_pin_base, addr_pin_count);
    sm_config_set_out_shift(&c, true, false, addr_pin_count);
    sm_config_set_sideset_pins(&c, rw_pin_base);

    pio_sm_set_consecutive_pindirs(pio, sm, rw_pin_base, 2, true);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
}

%}
